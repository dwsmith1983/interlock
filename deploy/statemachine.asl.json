{
  "Comment": "Interlock v2 pipeline lifecycle: evaluation, trigger, job polling, SLA monitoring via EventBridge Scheduler",
  "StartAt": "InitEvalLoop",
  "TimeoutSeconds": ${sfn_timeout_seconds},
  "States": {
    "InitEvalLoop": {
      "Type": "Pass",
      "Comment": "Initialize elapsed-seconds counter for the evaluation window",
      "Result": {
        "elapsedSeconds": 0
      },
      "ResultPath": "$.evalLoop",
      "Next": "Evaluate"
    },
    "Evaluate": {
      "Type": "Task",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "evaluate",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date"
      },
      "ResultPath": "$.evaluateResult",
      "Next": "IsReady",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "InfraFailure"
        }
      ]
    },
    "IsReady": {
      "Type": "Choice",
      "Comment": "Trigger when evaluation passed; end the run in ValidationExhausted when the cutoff has passed; otherwise wait and evaluate again",
      "Choices": [
        {
          "Variable": "$.evaluateResult.status",
          "StringEquals": "passed",
          "Next": "Trigger"
        },
        {
          "Variable": "$.evaluateResult.status",
          "StringEquals": "cutoff",
          "Next": "ValidationExhausted"
        }
      ],
      "Default": "WaitInterval"
    },
    "WaitInterval": {
      "Type": "Wait",
      "Comment": "Wait before the next evaluation attempt",
      "SecondsPath": "$.config.evaluationIntervalSeconds",
      "Next": "IncrementElapsed"
    },
    "IncrementElapsed": {
      "Type": "Pass",
      "Comment": "Track total elapsed seconds in the evaluation window",
      "Parameters": {
        "elapsedSeconds.$": "States.MathAdd($.evalLoop.elapsedSeconds, $.config.evaluationIntervalSeconds)"
      },
      "ResultPath": "$.evalLoop",
      "Next": "CheckWindowExhausted"
    },
    "CheckWindowExhausted": {
      "Type": "Choice",
      "Comment": "Has the evaluation window been exceeded?",
      "Choices": [
        {
          "Variable": "$.evalLoop.elapsedSeconds",
          "NumericGreaterThanEqualsPath": "$.config.evaluationWindowSeconds",
          "Next": "ValidationExhausted"
        }
      ],
      "Default": "Evaluate"
    },
    "ValidationExhausted": {
      "Type": "Task",
      "Comment": "Window closed without passing; no job ran, so the SLA cancel is skipped. For a first run before the cutoff, release the trigger lock and publish EVALUATION_RELEASED. For a rerun, or a config without a cutoff (read without validation), publish VALIDATION_EXHAUSTED and set FAILED_FINAL. Past the cutoff, for a first run, publish SENSOR_DEADLINE_EXPIRED and set FAILED_FINAL",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "validation-exhausted",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date"
      },
      "ResultPath": "$.validationExhaustedResult",
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "InfraFailure"
        }
      ]
    },
    "Trigger": {
      "Type": "Task",
      "Comment": "Invoke the pipeline trigger; returns a runId and metadata. Infra failures return Lambda errors, retried up to trigger_max_attempts times (default 3: waits of 30s, 60s, 120s).",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "trigger",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "executionName.$": "$$.Execution.Name"
      },
      "ResultPath": "$.triggerResult",
      "Next": "HasTriggerResult",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": ${trigger_max_attempts},
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "TriggerRetryExhausted"
        }
      ]
    },
    "TriggerRetryExhausted": {
      "Type": "Task",
      "Comment": "Write joblog entry, publish RETRY_EXHAUSTED event, set the trigger row FAILED_FINAL",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "trigger-exhausted",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "errorInfo.$": "$.errorInfo"
      },
      "ResultPath": "$.triggerExhaustedResult",
      "Next": "CheckCancelSLA",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "CheckCancelSLA"
        }
      ]
    },
    "HasTriggerResult": {
      "Type": "Choice",
      "Comment": "Poll the job when Trigger wrote $.triggerResult; otherwise fail the execution",
      "Choices": [
        {
          "Variable": "$.triggerResult",
          "IsPresent": true,
          "Next": "InitJobPollLoop"
        }
      ],
      "Default": "FailValidationExhausted"
    },
    "FailValidationExhausted": {
      "Type": "Fail",
      "Error": "ValidationExhausted",
      "Cause": "Evaluation window closed without all validation rules passing"
    },
    "InitJobPollLoop": {
      "Type": "Pass",
      "Comment": "Initialize elapsed-seconds counter for job poll window",
      "Result": { "elapsedSeconds": 0 },
      "ResultPath": "$.jobPollLoop",
      "Next": "WaitForJob"
    },
    "WaitForJob": {
      "Type": "Wait",
      "Comment": "Wait before polling the triggered job",
      "SecondsPath": "$.config.jobCheckIntervalSeconds",
      "Next": "CheckJob"
    },
    "CheckJob": {
      "Type": "Task",
      "Comment": "Poll triggered job status via trigger API",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "check-job",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "runId.$": "$.triggerResult.runId",
        "metadata.$": "$.triggerResult.metadata"
      },
      "ResultPath": "$.checkJobResult",
      "Next": "IsJobDone",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "InfraFailure"
        }
      ]
    },
    "IsJobDone": {
      "Type": "Choice",
      "Comment": "Route on job-check outcome: terminal events proceed to trigger completion, otherwise keep polling",
      "Choices": [
        {
          "Not": {
            "Variable": "$.checkJobResult.event",
            "IsPresent": true
          },
          "Next": "IncrementJobPollElapsed"
        },
        {
          "Variable": "$.checkJobResult.event",
          "StringEquals": "success",
          "Next": "CompleteTrigger"
        },
        {
          "Variable": "$.checkJobResult.event",
          "StringEquals": "fail",
          "Next": "CompleteTrigger"
        },
        {
          "Variable": "$.checkJobResult.event",
          "StringEquals": "timeout",
          "Next": "CompleteTrigger"
        }
      ],
      "Default": "IncrementJobPollElapsed"
    },
    "IncrementJobPollElapsed": {
      "Type": "Pass",
      "Comment": "Track total elapsed seconds in job poll window",
      "Parameters": {
        "elapsedSeconds.$": "States.MathAdd($.jobPollLoop.elapsedSeconds, $.config.jobCheckIntervalSeconds)"
      },
      "ResultPath": "$.jobPollLoop",
      "Next": "CheckJobPollExhausted"
    },
    "CheckJobPollExhausted": {
      "Type": "Choice",
      "Comment": "Has the job poll window been exceeded?",
      "Choices": [
        {
          "Variable": "$.jobPollLoop.elapsedSeconds",
          "NumericGreaterThanEqualsPath": "$.config.jobPollWindowSeconds",
          "Next": "JobPollExhausted"
        }
      ],
      "Default": "WaitForJob"
    },
    "JobPollExhausted": {
      "Type": "Task",
      "Comment": "Best effort: write a timeout row for the run, which the stream-router reports as JOB_FAILED; CompleteTrigger decides the retry either way",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "job-poll-exhausted",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "runId.$": "$.triggerResult.runId"
      },
      "ResultPath": "$.jobPollExhaustedResult",
      "Next": "InjectTimeoutEvent",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "InjectTimeoutEvent"
        }
      ]
    },
    "InjectTimeoutEvent": {
      "Type": "Pass",
      "Comment": "Inject timeout event so CompleteTrigger reads event=timeout",
      "Result": { "event": "timeout" },
      "ResultPath": "$.checkJobResult",
      "Next": "CompleteTrigger"
    },
    "CompleteTrigger": {
      "Type": "Task",
      "Comment": "Decide what follows the run: COMPLETED on success; on fail/timeout start the next attempt (status retrying) until the retry budget is spent, then FAILED_FINAL",
      "Resource": "${orchestrator_arn}",
      "Parameters": {
        "mode": "complete-trigger",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "event.$": "$.checkJobResult.event",
        "runId.$": "$.triggerResult.runId",
        "executionName.$": "$$.Execution.Name"
      },
      "ResultPath": "$.completeTriggerResult",
      "Next": "IsRetrying",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "CheckSLAForCompleteTriggerFailure"
        }
      ]
    },
    "IsRetrying": {
      "Type": "Choice",
      "Comment": "A started retry owns the SLA schedules, so skip CancelSLA",
      "Choices": [
        {
          "Variable": "$.completeTriggerResult.status",
          "StringEquals": "retrying",
          "Next": "Done"
        }
      ],
      "Default": "CheckCancelSLA"
    },
    "CheckSLAForCompleteTriggerFailure": {
      "Type": "Choice",
      "Comment": "Cancel SLA before failing if SLA was configured; otherwise fail immediately",
      "Choices": [
        {
          "Variable": "$.config.sla",
          "IsPresent": true,
          "Next": "CancelSLAOnCompleteTriggerFailure"
        }
      ],
      "Default": "CompleteTriggerFailed"
    },
    "CancelSLAOnCompleteTriggerFailure": {
      "Type": "Task",
      "Comment": "Best-effort SLA cancellation before marking CompleteTrigger as failed",
      "Resource": "${sla_monitor_arn}",
      "Parameters": {
        "mode": "cancel",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "deadline.$": "$.config.sla.deadline",
        "expectedDuration.$": "$.config.sla.expectedDuration",
        "maxDuration.$": "$.config.sla.maxDuration",
        "timezone.$": "$.config.sla.timezone",
        "sensorArrivalAt.$": "$.sensorArrivalAt"
      },
      "ResultPath": "$.slaResult",
      "Next": "CompleteTriggerFailed",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.slaErrorInfo",
          "Next": "CompleteTriggerFailed"
        }
      ]
    },
    "CompleteTriggerFailed": {
      "Type": "Fail",
      "Error": "CompleteTriggerFailed",
      "Cause": "Failed to set trigger to terminal status after retries"
    },
    "CheckCancelSLA": {
      "Type": "Choice",
      "Comment": "Cancel SLA schedules if SLA was configured, otherwise finish",
      "Choices": [
        {
          "Variable": "$.config.sla",
          "IsPresent": true,
          "Next": "CancelSLASchedules"
        }
      ],
      "Default": "Done"
    },
    "CancelSLASchedules": {
      "Type": "Task",
      "Comment": "Delete unfired SLA schedules and record final SLA outcome",
      "Resource": "${sla_monitor_arn}",
      "Parameters": {
        "mode": "cancel",
        "pipelineId.$": "$.pipelineId",
        "scheduleId.$": "$.scheduleId",
        "date.$": "$.date",
        "deadline.$": "$.config.sla.deadline",
        "expectedDuration.$": "$.config.sla.expectedDuration",
        "maxDuration.$": "$.config.sla.maxDuration",
        "timezone.$": "$.config.sla.timezone",
        "sensorArrivalAt.$": "$.sensorArrivalAt"
      },
      "ResultPath": "$.slaResult",
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 7,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "Done"
        }
      ]
    },
    "InfraFailure": {
      "Type": "Fail",
      "Error": "InfraFailure",
      "Cause": "Unrecoverable infrastructure error"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
